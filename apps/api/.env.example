DJANGO_SETTINGS_MODULE=nova.settings.dev
SECRET_KEY=change-me
DATABASE_URL=postgres://nova:nova@localhost:55432/nova
REDIS_URL=redis://localhost:56379/0

NOVA_BASE_DOMAIN=nova.example
NOVA_ADMIN_URL=http://localhost:3000

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated, newest first. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOVA_FERNET_KEYS=

# Reverse proxies in front of the API (Caddy in prod = 1). 0 trusts REMOTE_ADDR only.
NOVA_TRUSTED_PROXY_COUNT=0

RESEND_API_KEY=
NOVA_EMAIL_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
